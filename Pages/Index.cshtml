@page
@using lilgobguides.Models
@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

<div>
    <h1>Milkraven's notes</h1>

    <p class="fs-4">
        Old School Runescape Ultimate Ironman notes
    </p>
</div>

<section class="my-4">
    <div class="col-lg-5">
        <label for="post-search" class="form-label">
            Search
        </label>

        <input id="post-search"
               type="search"
               class="form-control"
               placeholder="Search by title..."
               autocomplete="off" />
    </div>
</section>

<section>
    <div id="post-list"
         class="list-group list-group-flush col-lg-5">

        @foreach (Post post in Model.Posts)
        {
            <div class="post-search-result post-list-item text-break text-light"
                 data-post-title="@post.Title.ToLowerInvariant()">

                <partial name="Posts/_PostListItem" model="post" />
            </div>
        }
    </div>

    <p id="no-post-results"
       class="text-muted d-none">
        No guides matched your search.
    </p>
</section>

@section Scripts {
    <script>
        (() => {
            const searchInput = document.getElementById("post-search");
            const postResults = document.querySelectorAll(".post-search-result");
            const noResultsMessage = document.getElementById("no-post-results");

            searchInput.addEventListener("input", () => {
                const searchTerm = searchInput.value
                    .trim()
                    .toLowerCase();

                let visiblePostCount = 0;

                for (const postResult of postResults) {
                    const postTitle = postResult.dataset.postTitle ?? "";
                    const matches = postTitle.includes(searchTerm);

                    postResult.classList.toggle("d-none", !matches);

                    if (matches) {
                        visiblePostCount++;
                    }
                }

                noResultsMessage.classList.toggle(
                    "d-none",
                    visiblePostCount > 0
                );
            });
        })();
    </script>
}
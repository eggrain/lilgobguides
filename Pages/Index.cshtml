@page
@using lilgobguides.Models
@model IndexModel

@{
    ViewData["Title"] = "Home page";
}

<div>
    <h1>Milkraven's notes</h1>

    <p class="fs-4">
        Old School Runescape Ultimate Ironman notes
    </p>
</div>

@if (Model.FeaturedPosts.Count > 0)
{
    <section class="my-4">
        <div class="col-lg-5">
            <h2 class="h4">
                Featured
            </h2>

            <div class="list-group list-group-flush">
                @foreach (Post post in Model.FeaturedPosts)
                {
                    <div class="post-list-item text-break text-light">
                        <partial name="Posts/_PostListItem"
                                 model="post" />
                    </div>
                }
            </div>
        </div>
    </section>
}

<section class="my-4">
    <div class="col-lg-5">
        <label for="post-search"
               class="form-label">
            Search
        </label>

        <input id="post-search"
               type="search"
               class="form-control"
               placeholder="Search guides..."
               autocomplete="off" />

        <div class="mt-3">
            <span class="form-label d-block">
                Category
            </span>

            <div id="category-filters"
                 class="d-flex flex-wrap gap-2">

                <button type="button"
                        class="btn btn-sm btn-primary category-filter"
                        data-category="all">
                    All
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary category-filter"
                        data-category="skilling">
                    Skilling
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary category-filter"
                        data-category="minigame">
                    Minigame
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary category-filter"
                        data-category="item">
                    Item
                </button>

                <button type="button"
                        class="btn btn-sm btn-outline-primary category-filter"
                        data-category="boss">
                    Boss
                </button>
            </div>
        </div>

        <p id="post-result-count"
           class="small text-muted mt-3 mb-0"
           aria-live="polite">
            @Model.Posts.Count @(Model.Posts.Count == 1 ? "guide" : "guides")
        </p>
    </div>
</section>

<section>
    <div id="post-list"
         class="list-group list-group-flush col-lg-5">

        @foreach (Post post in Model.Posts)
        {
            string searchableText =
                $"{post.Title} {post.Content}".ToLowerInvariant();

            <div class="post-search-result post-list-item text-break text-light"
                 data-post-search="@searchableText"
                 data-skilling="@post.Categorization.Skilling.ToString().ToLowerInvariant()"
                 data-minigame="@post.Categorization.Minigame.ToString().ToLowerInvariant()"
                 data-item="@post.Categorization.Item.ToString().ToLowerInvariant()"
                 data-boss="@post.Categorization.Boss.ToString().ToLowerInvariant()">

                <partial name="Posts/_PostListItem"
                         model="post" />
            </div>
        }
    </div>

    <p id="no-post-results"
       class="text-muted d-none">
        No guides matched your search.
    </p>
</section>

@section Scripts {
    <script>
        (() => {
            const searchInput =
                document.getElementById("post-search");

            const postResults =
                document.querySelectorAll(".post-search-result");

            const categoryButtons =
                document.querySelectorAll(".category-filter");

            const noResultsMessage =
                document.getElementById("no-post-results");

            const resultCount =
                document.getElementById("post-result-count");

            let selectedCategory = "all";

            const updateResults = () => {
                const searchTerms = searchInput.value
                    .trim()
                    .toLowerCase()
                    .split(/\s+/)
                    .filter(Boolean);

                let visiblePostCount = 0;

                for (const postResult of postResults) {
                    const searchableText =
                        postResult.dataset.postSearch ?? "";

                    const matchesSearch = searchTerms.every(term =>
                        searchableText.includes(term)
                    );

                    const matchesCategory =
                        selectedCategory === "all" ||
                        postResult.dataset[selectedCategory] === "true";

                    const visible =
                        matchesSearch && matchesCategory;

                    postResult.classList.toggle(
                        "d-none",
                        !visible
                    );

                    if (visible) {
                        visiblePostCount++;
                    }
                }

                noResultsMessage.classList.toggle(
                    "d-none",
                    visiblePostCount > 0
                );

                resultCount.textContent =
                    `${visiblePostCount} ${
                        visiblePostCount === 1
                            ? "guide"
                            : "guides"
                    }`;
            };

            const selectCategory = selectedButton => {
                selectedCategory =
                    selectedButton.dataset.category ?? "all";

                for (const button of categoryButtons) {
                    const isSelected =
                        button === selectedButton;

                    button.classList.toggle(
                        "btn-primary",
                        isSelected
                    );

                    button.classList.toggle(
                        "btn-outline-primary",
                        !isSelected
                    );

                    button.setAttribute(
                        "aria-pressed",
                        isSelected.toString()
                    );
                }

                updateResults();
            };

            searchInput.addEventListener(
                "input",
                updateResults
            );

            for (const button of categoryButtons) {
                button.addEventListener("click", () => {
                    selectCategory(button);
                });
            }
        })();
    </script>
}
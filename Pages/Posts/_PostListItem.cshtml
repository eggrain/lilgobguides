@using System.Text.RegularExpressions
@model lilgobguides.Models.Post

@{
    var plainText = Regex.Replace(Model.Content ?? "", "<.*?>", "");
    plainText = System.Net.WebUtility.HtmlDecode(plainText).Trim();

    var excerpt = plainText.Length > 100
        ? $"{plainText[..100]}..."
        : plainText;

    string? imageSource = null;

    if (Model.HeaderImageData != null &&
        Model.HeaderImageContentType != null)
    {
        var base64 = Convert.ToBase64String(Model.HeaderImageData);
        imageSource = $"data:{Model.HeaderImageContentType};base64,{base64}";
    }
}

<div class="post-list-item">
    <a asp-page="/Posts/ShowPost"
       asp-route-id="@Model.Id"
       class="post-list-item-link">
        @Model.Title
    </a>

    <div class="post-list-item-preview">
        <div class="card post-list-item-card">
            @if (imageSource != null)
            {
                <img src="@imageSource"
                     class="card-img-top post-list-item-image"
                     alt="" />
            }

            <div class="card-body">
                <h5 class="card-title">
                    @Model.Title
                </h5>

                @if (!string.IsNullOrWhiteSpace(excerpt))
                {
                    <p class="card-text">
                        @excerpt
                    </p>
                }

                <a asp-page="/Posts/ShowPost"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Read more
                </a>
            </div>
        </div>
    </div>
</div>